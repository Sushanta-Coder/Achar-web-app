{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",

  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://achar-ghar-api.onrender.com/api/$1" },
    { "source": "/sitemap.xml", "destination": "https://achar-ghar-api.onrender.com/sitemap.xml" },
    { "source": "/robots.txt",  "destination": "https://achar-ghar-api.onrender.com/robots.txt"  },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY"    },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
