# ─────────────────────────────────────────────
# Deeva Achar — server environment variables
# Copy this file to .env and fill in the blanks.
# Never commit .env to Git.
# ─────────────────────────────────────────────

# ── Node ──────────────────────────────────────
NODE_ENV=development          # development | production | test

# ── Server ────────────────────────────────────
PORT=5000

# ── MongoDB ───────────────────────────────────
# Leave blank in development: the server falls back to an in-memory MongoDB
# so `npm run dev` works out of the box without a local install.
# Required in production.
MONGO_URI=mongodb://127.0.0.1:27017/achar-ghar
# Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/achar-ghar?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Both secrets must be at least 32 characters and must differ from each other.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS / URLs ───────────────────────────────
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
# Comma-separated list of additional origins to allow (optional):
# CORS_ORIGINS=https://www.deevaachar.com.np,https://deevaachar.com.np

# ── Cookies ───────────────────────────────────
# Set COOKIE_CROSS_SITE=true when the frontend and backend are on different domains
# (e.g. Vercel frontend → Render backend). Forces SameSite=None + Secure.
COOKIE_CROSS_SITE=false
COOKIE_SECURE=false           # set true in production (HTTPS only)
# COOKIE_DOMAIN=.deevaachar.com.np

# ── Rate limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes in ms
RATE_LIMIT_MAX=300             # requests per window for general routes
RATE_LIMIT_AUTH_MAX=12         # requests per window for auth routes

# ── Khalti (digital wallet) ───────────────────
# Sandbox dashboard: https://dev.khalti.com
# Live dashboard:    https://khalti.com/merchant
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_SECRET_KEY=
KHALTI_PUBLIC_KEY=

# ── eSewa (digital wallet) ────────────────────
# Sandbox dashboard: https://developer.esewa.com.np
# Live dashboard:    https://esewa.com.np/epay/merchant
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
ESEWA_MERCHANT_ID=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PRODUCT_CODE=EPAYTEST

# ── Cloudinary (image storage) ────────────────
# Recommended for production. Leave blank and uploads still work - they are written to
# server/uploads/ and served from /uploads instead. That is fine locally, but most free
# hosts (Render, Railway) wipe the container's disk on every deploy, so set these before
# going live or your product photos disappear on the next release.
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=achar-ghar

# ── Email (transactional) ─────────────────────
# Order confirmations, password reset, email verification.
# Leave everything blank to skip email in development (the server logs the message instead).
#
# Two transports. EMAIL_PROVIDER picks one; if it is unset, setting BREVO_API_KEY
# selects `brevo` and anything else falls back to `smtp`.
#
#   brevo  - posts to Brevo's REST API over 443. Use this on Render, Fly, Railway and
#            other free tiers: they block outbound SMTP (25/465/587) to keep spammers
#            out, so an SMTP transport there fails to connect however correct the
#            credentials are. Only BREVO_API_KEY and EMAIL_FROM are read.
#   smtp   - plain SMTP via nodemailer, for a paid host or a local Mailpit.
#
# EMAIL_FROM must be an address you have verified with the provider, or the send is
# rejected. In Brevo: Senders, domains & dedicated IPs -> Senders -> Add a sender.
EMAIL_PROVIDER=               # brevo | smtp  (blank = auto)
BREVO_API_KEY=                # Brevo -> SMTP & API -> API keys
EMAIL_HOST=smtp.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false            # set true for port 465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Deeva Achar <no-reply@deevaachar.com.np>

# ── Seed script ───────────────────────────────
# Used only when running `npm run seed`.
# SEED_ADMIN_PASSWORD is required by the seed script; it is never defaulted.
SEED_ADMIN_EMAIL=admin@deevaachar.com.np
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Deeva Achar Admin
# Demo customer accounts (created only in development, never in production):
SEED_DEMO_PASSWORD=

# ── Upload limits ─────────────────────────────
UPLOAD_MAX_BYTES=5242880      # 5 MB
# Set to `local` to force disk storage even when Cloudinary keys are present.
# Leave blank to pick automatically: Cloudinary if configured, local disk otherwise.
UPLOAD_DRIVER=

# ── Inventory reservations ────────────────────
# Minutes before an unpaid reservation is released back to stock.
RESERVATION_TTL_MINUTES=45
